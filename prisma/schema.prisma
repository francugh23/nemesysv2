generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  REGISTRAR
  PRINCIPAL
  TEACHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  UNENROLLED
  ENROLLED
  GRADUATED
  TRANSFERRED
  DROPPED
}

enum Shift {
  MORNING
  AFTERNOON
}

enum Semester {
  FIRST
  SECOND
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  TRANSFERRED
}

enum EnrollmentShsTrack {
  ACADEMIC
  TECHPRO
}

enum StudentSubjectEnrollmentStatus {
  ACTIVE
  REPLACED
  DROPPED
}

enum ShsTermResultStatus {
  DRAFT
  FINALIZED
}

enum ShsTermResultInterpretationPolicyStatus {
  DRAFT
  PUBLISHED
}

enum AcademicYearStatus {
  DRAFT
  ACTIVE
  LOCKED
  ARCHIVED
}

enum ShsSubjectClassification {
  CORE
  ACADEMIC_ELECTIVE
  TECHPRO_ELECTIVE
}

enum ShsStudentParticipationCorrectionKind {
  CORE
  ACADEMIC_ELECTIVE
  TECHPRO_ELECTIVE
}

enum ShsCurriculumStatus {
  PROVISIONAL_DEPED
  SCHOOL_APPROVED
}

enum ShsCurriculumClusterTrack {
  ACADEMIC
  TECHPRO
}

enum ShsCurriculumReferenceTermApplicability {
  UNSPECIFIED
  ALL_CONFIGURED_TERMS
  ONE_CONFIGURED_TERM_UNRESOLVED
  EXACT_CONFIGURED_TERMS
}

enum ShsAcademicSchoolCategory {
  ARTS_SOCIAL_SCIENCE_HUMANITIES
  BUSINESS_ENTREPRENEURSHIP
  SCIENCE_TECHNOLOGY_ENGINEERING_MATHEMATICS
  ICT_SUPPORT_COMPUTER_PROGRAMMING_TECHNOLOGIES
}

model User {
  id String @id @default(cuid())

  employeeNumber String? @unique

  username     String @unique
  email        String @unique
  passwordHash String

  firstName  String
  middleName String?
  lastName   String

  gender Gender

  role   UserRole
  status UserStatus @default(ACTIVE)

  isFirstLogin   Boolean   @default(true)
  lastLoginAt    DateTime?
  sessionVersion Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  teacher                                      Teacher?
  createdStudents                              Student[]
  createdSections                              Section[]
  createdSubjects                              Subject[]
  createdEnrollments                           Enrollment[]
  createdGrades                                Grade[]
  createdAcademicYears                         AcademicYear[]
  createdAcademicTerms                         AcademicTerm[]
  createdSubjectOfferings                      SubjectOffering[]
  createdShsCurriculumClusters                 ShsCurriculumCluster[]
  createdSubjectOfferingShsContexts            SubjectOfferingShsContext[]
  approvedSubjectOfferingShsContexts           SubjectOfferingShsContext[]         @relation("ShsCurriculumApprovalActor")
  createdShsCurriculumReferences               ShsCurriculumReference[]
  createdStudentSubjectEnrollments             StudentSubjectEnrollment[]
  createdShsElectiveEnrollmentPolicies         ShsElectiveEnrollmentPolicy[]
  createdShsTermResults                        ShsTermResult[]                     @relation("ShsTermResultCreator")
  finalizedShsTermResults                      ShsTermResult[]                     @relation("ShsTermResultFinalizer")
  finalizedCurricula                           CurriculumFinalization[]            @relation("CurriculumFinalizer")
  curriculumCorrections                        CurriculumCorrection[]              @relation("CurriculumCorrectionActor")
  studentEnrollmentCorrections                 StudentEnrollmentCorrection[]       @relation("StudentEnrollmentCorrectionActor")
  studentEnrollmentGradeCorrections            StudentEnrollmentGradeCorrection[]  @relation("StudentEnrollmentGradeCorrectionActor")
  shsStudentParticipationCorrections           ShsStudentParticipationCorrection[] @relation("ShsStudentParticipationCorrectionActor")
  createdShsTermResultInterpretationPolicies   ShsTermResultInterpretationPolicy[] @relation("ShsTermResultInterpretationPolicyCreator")
  publishedShsTermResultInterpretationPolicies ShsTermResultInterpretationPolicy[] @relation("ShsTermResultInterpretationPolicyPublisher")
  auditLogs                                    AuditLog[]
}

model Student {
  id String @id @default(cuid())

  lrn String @unique

  firstName  String
  middleName String?
  lastName   String

  gender      Gender
  dateOfBirth DateTime?

  fatherName    String?
  fatherContact String?

  motherName    String?
  motherContact String?

  guardianName    String?
  guardianContact String?

  purok        String?
  barangay     String
  municipality String
  province     String
  zipCode      String?

  status StudentStatus @default(UNENROLLED)

  currentSectionId String?
  currentSection   Section? @relation("StudentCurrentSection", fields: [currentSectionId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  enrollments Enrollment[]

  @@index([currentSectionId])
}

model Teacher {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  degree    String?
  major     String?
  isAdviser Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  advisedSections    Section[]           @relation("SectionAdviser")
  subjectAssignments SubjectAssignment[]
}

model AcademicTerm {
  id String @id @default(cuid())

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  name      String
  position  Int
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt                              DateTime                            @default(now())
  updatedAt                              DateTime                            @updatedAt
  subjectOfferings                       SubjectOfferingTerm[]
  studentSubjectEnrollmentTerms          StudentSubjectEnrollmentTerm[]
  selectedStudentSubjectEnrollments      StudentSubjectEnrollment[]          @relation("StudentSubjectEnrollmentSelectionAcademicTerm")
  entryEnrollments                       Enrollment[]                        @relation("EnrollmentEntryAcademicTerm")
  shsElectiveEnrollmentPolicies          ShsElectiveEnrollmentPolicy[]
  curriculumCorrections                  CurriculumCorrection[]
  sourceShsParticipationCorrections      ShsStudentParticipationCorrection[] @relation("ShsStudentParticipationCorrectionSourceAcademicTerm")
  replacementShsParticipationCorrections ShsStudentParticipationCorrection[] @relation("ShsStudentParticipationCorrectionReplacementAcademicTerm")

  @@unique([academicYearId, position])
  @@unique([id, academicYearId])
  @@index([academicYearId])
  @@index([createdById])
}

model Section {
  id String @id @default(cuid())

  gradeLevel  String
  trackStrand String?
  sectionName String

  adviserId String?
  adviser   Teacher? @relation("SectionAdviser", fields: [adviserId], references: [id])

  room  String?
  shift Shift?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  subjectAssignments                    SubjectAssignment[]
  enrollments                           Enrollment[]
  currentStudents                       Student[]                          @relation("StudentCurrentSection")
  sourceEnrollmentCorrections           StudentEnrollmentCorrection[]      @relation("StudentEnrollmentCorrectionSourceSection")
  destinationEnrollmentCorrections      StudentEnrollmentCorrection[]      @relation("StudentEnrollmentCorrectionDestinationSection")
  sourceEnrollmentGradeCorrections      StudentEnrollmentGradeCorrection[] @relation("StudentEnrollmentGradeCorrectionSourceSection")
  destinationEnrollmentGradeCorrections StudentEnrollmentGradeCorrection[] @relation("StudentEnrollmentGradeCorrectionDestinationSection")
}

model Subject {
  id String @id @default(cuid())

  code        String
  description String

  gradeLevel  String
  trackStrand String?

  semester Semester?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  assignments             SubjectAssignment[]
  offerings               SubjectOffering[]
  grades                  Grade[]
  shsCurriculumReferences ShsCurriculumReference[]
}

model SubjectAssignment {
  id String @id @default(cuid())

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])

  schedule       String?
  room           String?
  shift          Shift?
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([subjectId, teacherId, sectionId, academicYearId])
  @@index([academicYearId])
}

model Enrollment {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  shsTrack            EnrollmentShsTrack?
  entryAcademicTermId String?
  entryAcademicTerm   AcademicTerm?       @relation("EnrollmentEntryAcademicTerm", fields: [entryAcademicTermId, academicYearId], references: [id, academicYearId], onDelete: Restrict)

  semester Semester?

  status EnrollmentStatus @default(ACTIVE)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  grades                      Grade[]
  studentSubjectEnrollments   StudentSubjectEnrollment[]
  placementCorrections        StudentEnrollmentCorrection[]
  gradeCorrections            StudentEnrollmentGradeCorrection[]
  shsParticipationCorrections ShsStudentParticipationCorrection[]

  @@unique([studentId, academicYearId])
  @@index([academicYearId])
  @@index([entryAcademicTermId])
}

model StudentEnrollmentCorrection {
  id       String @id @default(cuid())
  sequence BigInt @unique @default(autoincrement())

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  sourceSectionId String
  sourceSection   Section @relation("StudentEnrollmentCorrectionSourceSection", fields: [sourceSectionId], references: [id], onDelete: Restrict)

  destinationSectionId String
  destinationSection   Section @relation("StudentEnrollmentCorrectionDestinationSection", fields: [destinationSectionId], references: [id], onDelete: Restrict)

  sourcePlacementSnapshot      Json
  destinationPlacementSnapshot Json
  enrollmentCreatedAtSnapshot  DateTime

  reason            String
  evidenceReference String

  correctedById String
  correctedBy   User     @relation("StudentEnrollmentCorrectionActor", fields: [correctedById], references: [id], onDelete: Restrict)
  correctedAt   DateTime
  createdAt     DateTime @default(now())

  @@index([enrollmentId, correctedAt])
  @@index([sourceSectionId])
  @@index([destinationSectionId])
  @@index([correctedById])
}

model StudentEnrollmentGradeCorrection {
  id       String @id @default(cuid())
  sequence BigInt @unique @default(autoincrement())

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  sourceSectionId String
  sourceSection   Section @relation("StudentEnrollmentGradeCorrectionSourceSection", fields: [sourceSectionId], references: [id], onDelete: Restrict)

  destinationSectionId String
  destinationSection   Section @relation("StudentEnrollmentGradeCorrectionDestinationSection", fields: [destinationSectionId], references: [id], onDelete: Restrict)

  sourcePlacementSnapshot      Json
  destinationPlacementSnapshot Json
  enrollmentCreatedAtSnapshot  DateTime

  reason            String
  evidenceReference String

  sourceParticipationCount      Int
  replacementParticipationCount Int

  correctedById String
  correctedBy   User     @relation("StudentEnrollmentGradeCorrectionActor", fields: [correctedById], references: [id], onDelete: Restrict)
  correctedAt   DateTime
  createdAt     DateTime @default(now())

  participationCorrections StudentParticipationCorrection[]

  @@index([enrollmentId, correctedAt])
  @@index([sourceSectionId])
  @@index([destinationSectionId])
  @@index([correctedById])
}

model StudentParticipationCorrection {
  id String @id @default(cuid())

  studentEnrollmentGradeCorrectionId String
  studentEnrollmentGradeCorrection   StudentEnrollmentGradeCorrection @relation(fields: [studentEnrollmentGradeCorrectionId], references: [id], onDelete: Restrict, map: "StudentParticipationCorrection_gradeCorrectionId_fkey")

  sourceStudentSubjectEnrollmentId String                   @unique(map: "StudentParticipationCorrection_sourceStudentSubjectEnrollmentId")
  sourceStudentSubjectEnrollment   StudentSubjectEnrollment @relation("StudentParticipationCorrectionSource", fields: [sourceStudentSubjectEnrollmentId], references: [id], onDelete: Restrict, map: "StudentParticipationCorrection_sourceSseId_fkey")

  replacementStudentSubjectEnrollmentId String                   @unique(map: "StudentParticipationCorrection_replacementStudentSubjectEnrollm")
  replacementStudentSubjectEnrollment   StudentSubjectEnrollment @relation("StudentParticipationCorrectionReplacement", fields: [replacementStudentSubjectEnrollmentId], references: [id], onDelete: Restrict, map: "StudentParticipationCorrection_replacementSseId_fkey")

  canonicalSubjectPrefix           String
  sourceParticipationSnapshot      Json
  replacementParticipationSnapshot Json
  createdAt                        DateTime @default(now())

  @@unique([studentEnrollmentGradeCorrectionId, canonicalSubjectPrefix], map: "StudentParticipationCorrection_correction_prefix_key")
  @@index([studentEnrollmentGradeCorrectionId], map: "StudentParticipationCorrection_studentEnrollmentGradeCorrection")
}

model ShsStudentParticipationCorrection {
  id       String @id @default(cuid())
  sequence BigInt @unique @default(autoincrement())

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  sourceStudentSubjectEnrollmentId String                       @unique(map: "ShsStudentParticipationCorrection_source_sse_key")
  sourceStudentSubjectEnrollment   StudentSubjectEnrollment     @relation("ShsStudentParticipationCorrectionSource", fields: [sourceStudentSubjectEnrollmentId], references: [id], onDelete: Restrict, map: "ShsStudentParticipationCorrection_sourceSseId_fkey")
  sourceAcademicTermId             String
  sourceAcademicTerm               AcademicTerm                 @relation("ShsStudentParticipationCorrectionSourceAcademicTerm", fields: [sourceAcademicTermId], references: [id], onDelete: Restrict, map: "ShsStudentParticipationCorrection_sourceTerm_fkey")
  sourceTerm                       StudentSubjectEnrollmentTerm @relation("ShsStudentParticipationCorrectionSourceTerm", fields: [sourceStudentSubjectEnrollmentId, sourceAcademicTermId], references: [studentSubjectEnrollmentId, academicTermId], onDelete: Restrict, map: "ShsStudentParticipationCorrection_sourceMembership_fkey")

  replacementStudentSubjectEnrollmentId String                       @unique(map: "ShsStudentParticipationCorrection_replacement_sse_key")
  replacementStudentSubjectEnrollment   StudentSubjectEnrollment     @relation("ShsStudentParticipationCorrectionReplacement", fields: [replacementStudentSubjectEnrollmentId], references: [id], onDelete: Restrict, map: "ShsStudentParticipationCorrection_replacementSseId_fkey")
  replacementAcademicTermId             String
  replacementAcademicTerm               AcademicTerm                 @relation("ShsStudentParticipationCorrectionReplacementAcademicTerm", fields: [replacementAcademicTermId], references: [id], onDelete: Restrict, map: "ShsStudentParticipationCorrection_replacementTerm_fkey")
  replacementTerm                       StudentSubjectEnrollmentTerm @relation("ShsStudentParticipationCorrectionReplacementTerm", fields: [replacementStudentSubjectEnrollmentId, replacementAcademicTermId], references: [studentSubjectEnrollmentId, academicTermId], onDelete: Restrict, map: "ShsStudentParticipationCorrection_replacementMembership_fkey")

  kind ShsStudentParticipationCorrectionKind

  reason            String
  evidenceReference String

  sourceParticipationSnapshot      Json
  replacementParticipationSnapshot Json
  plannedTermScopeSnapshot         Json
  sourceResultStateSnapshot        Json

  correctedById String
  correctedBy   User     @relation("ShsStudentParticipationCorrectionActor", fields: [correctedById], references: [id], onDelete: Restrict)
  correctedAt   DateTime
  createdAt     DateTime @default(now())

  @@unique([sourceStudentSubjectEnrollmentId, sourceAcademicTermId], map: "ShsStudentParticipationCorrection_source_term_key")
  @@unique([replacementStudentSubjectEnrollmentId, replacementAcademicTermId], map: "ShsStudentParticipationCorrection_replacement_term_key")
  @@index([enrollmentId, correctedAt])
  @@index([correctedById])
}

model AcademicYear {
  id String @id @default(cuid())

  label     String             @unique
  startDate DateTime           @db.Date
  endDate   DateTime           @db.Date
  status    AcademicYearStatus @default(DRAFT)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments                       Enrollment[]
  subjectAssignments                SubjectAssignment[]
  terms                             AcademicTerm[]
  subjectOfferings                  SubjectOffering[]
  shsElectiveEnrollmentPolicies     ShsElectiveEnrollmentPolicy[]
  shsTermResultInterpretationPolicy ShsTermResultInterpretationPolicy?
  curriculumFinalization            CurriculumFinalization?
  curriculumCorrections             CurriculumCorrection[]

  @@index([status])
  @@index([startDate])
  @@index([createdById])
}

model CurriculumFinalization {
  id String @id @default(cuid())

  academicYearId String       @unique
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  finalizedById String
  finalizedBy   User     @relation("CurriculumFinalizer", fields: [finalizedById], references: [id], onDelete: Restrict)
  finalizedAt   DateTime
  createdAt     DateTime @default(now())

  @@index([finalizedById])
}

model SubjectOffering {
  id                              String                     @id @default(cuid())
  subjectId                       String
  subject                         Subject                    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  academicYearId                  String
  academicYear                    AcademicYear               @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  gradeLevel                      String
  subjectCode                     String
  subjectDescription              String
  createdById                     String
  createdBy                       User                       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt
  deletedAt                       DateTime?
  replacesSubjectOfferingId       String?                    @unique
  replacesSubjectOffering         SubjectOffering?           @relation("SubjectOfferingReplacement", fields: [replacesSubjectOfferingId], references: [id], onDelete: Restrict)
  replacementSubjectOffering      SubjectOffering?           @relation("SubjectOfferingReplacement")
  sourceCurriculumCorrection      CurriculumCorrection?      @relation("CurriculumCorrectionSource")
  replacementCurriculumCorrection CurriculumCorrection?      @relation("CurriculumCorrectionReplacement")
  terms                           SubjectOfferingTerm[]
  shsContext                      SubjectOfferingShsContext?
  studentSubjectEnrollments       StudentSubjectEnrollment[]

  @@index([academicYearId])
  @@index([subjectId])
}

model CurriculumCorrection {
  id String @id @default(cuid())

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  sourceOfferingId String          @unique
  sourceOffering   SubjectOffering @relation("CurriculumCorrectionSource", fields: [sourceOfferingId], references: [id], onDelete: Restrict)

  replacementOfferingId String          @unique
  replacementOffering   SubjectOffering @relation("CurriculumCorrectionReplacement", fields: [replacementOfferingId], references: [id], onDelete: Restrict)

  effectiveAcademicTermId String
  effectiveAcademicTerm   AcademicTerm @relation(fields: [effectiveAcademicTermId, academicYearId], references: [id, academicYearId], onDelete: Restrict, map: "CurriculumCorrection_effectiveTerm_year_fkey")

  reason                           String
  evidenceReference                String
  sourceWasFinalized               Boolean
  sourceParticipationCount         Int
  sourceConfigurationSnapshot      Json
  replacementConfigurationSnapshot Json

  correctedById String
  correctedBy   User     @relation("CurriculumCorrectionActor", fields: [correctedById], references: [id], onDelete: Restrict)
  correctedAt   DateTime
  createdAt     DateTime @default(now())

  @@index([academicYearId, effectiveAcademicTermId])
  @@index([correctedById])
}

model ShsCurriculumCluster {
  id String @id @default(cuid())

  code            String
  name            String
  track           ShsCurriculumClusterTrack
  sourceReference String?
  isSchoolFacing  Boolean                   @default(true)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  subjectOfferingContexts SubjectOfferingShsContext[]
  references              ShsCurriculumReference[]

  @@index([track])
  @@index([createdById])
}

model ShsCurriculumReference {
  id String @id @default(cuid())

  subjectId        String
  subject          Subject                  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradeLevel       String
  classification   ShsSubjectClassification
  curriculumStatus ShsCurriculumStatus      @default(PROVISIONAL_DEPED)

  clusterId String?
  cluster   ShsCurriculumCluster? @relation(fields: [clusterId], references: [id], onDelete: Restrict)

  sourceReference   String
  termApplicability ShsCurriculumReferenceTermApplicability
  termPositions     Int[]                                   @default([])
  schoolCategories  ShsAcademicSchoolCategory[]             @default([])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId])
  @@index([gradeLevel, classification])
  @@index([clusterId])
  @@index([curriculumStatus])
  @@index([createdById])
}

model SubjectOfferingShsContext {
  subjectOfferingId String          @id
  subjectOffering   SubjectOffering @relation(fields: [subjectOfferingId], references: [id], onDelete: Restrict)

  classification   ShsSubjectClassification
  curriculumStatus ShsCurriculumStatus

  clusterId String?
  cluster   ShsCurriculumCluster? @relation(fields: [clusterId], references: [id], onDelete: Restrict)

  sourceReference   String?
  approvalReference String?
  approvedById      String?
  approvedBy        User?     @relation("ShsCurriculumApprovalActor", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt        DateTime?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clusterId])
  @@index([curriculumStatus])
  @@index([createdById])
  @@index([approvedById])
}

model SubjectOfferingTerm {
  subjectOfferingId String
  subjectOffering   SubjectOffering @relation(fields: [subjectOfferingId], references: [id], onDelete: Restrict)
  academicTermId    String
  academicTerm      AcademicTerm    @relation(fields: [academicTermId], references: [id], onDelete: Restrict)

  @@id([subjectOfferingId, academicTermId])
  @@index([academicTermId])
}

model StudentSubjectEnrollment {
  id String @id @default(cuid())

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  subjectOfferingId String
  subjectOffering   SubjectOffering @relation(fields: [subjectOfferingId], references: [id], onDelete: Restrict)

  selectionAcademicTermId String?
  selectionAcademicTerm   AcademicTerm? @relation("StudentSubjectEnrollmentSelectionAcademicTerm", fields: [selectionAcademicTermId], references: [id], onDelete: Restrict)

  subjectCode        String
  subjectDescription String
  gradeLevel         String

  shsClassification    ShsSubjectClassification?
  shsClusterCode       String?
  shsClusterName       String?
  shsCurriculumStatus  ShsCurriculumStatus?
  shsSourceReference   String?
  shsApprovalReference String?

  status     StudentSubjectEnrollmentStatus @default(ACTIVE)
  replacedAt DateTime?
  droppedAt  DateTime?
  dropReason String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms                                 StudentSubjectEnrollmentTerm[]
  sourceParticipationCorrection         StudentParticipationCorrection?    @relation("StudentParticipationCorrectionSource")
  replacementParticipationCorrection    StudentParticipationCorrection?    @relation("StudentParticipationCorrectionReplacement")
  sourceShsParticipationCorrection      ShsStudentParticipationCorrection? @relation("ShsStudentParticipationCorrectionSource")
  replacementShsParticipationCorrection ShsStudentParticipationCorrection? @relation("ShsStudentParticipationCorrectionReplacement")

  @@index([enrollmentId, status])
  @@index([subjectOfferingId])
  @@index([selectionAcademicTermId])
  @@index([createdById])
}

model ShsElectiveEnrollmentPolicy {
  id String @id @default(cuid())

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  academicTermId String
  academicTerm   AcademicTerm @relation(fields: [academicTermId, academicYearId], references: [id, academicYearId], onDelete: Restrict)

  gradeLevel       String
  minimumElectives Int
  maximumElectives Int

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, academicTermId, gradeLevel], map: "ShsElectivePolicy_scope_key")
  @@index([academicYearId, academicTermId, gradeLevel], map: "ShsElectivePolicy_scope_idx")
  @@index([createdById])
}

model StudentSubjectEnrollmentTerm {
  studentSubjectEnrollmentId String
  studentSubjectEnrollment   StudentSubjectEnrollment @relation(fields: [studentSubjectEnrollmentId], references: [id], onDelete: Restrict)

  academicTermId String
  academicTerm   AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Restrict)

  result                                 ShsTermResult?
  sourceShsParticipationCorrections      ShsStudentParticipationCorrection[] @relation("ShsStudentParticipationCorrectionSourceTerm")
  replacementShsParticipationCorrections ShsStudentParticipationCorrection[] @relation("ShsStudentParticipationCorrectionReplacementTerm")

  @@id([studentSubjectEnrollmentId, academicTermId])
  @@index([academicTermId])
}

model ShsTermResult {
  id String @id @default(cuid())

  studentSubjectEnrollmentId   String
  academicTermId               String
  studentSubjectEnrollmentTerm StudentSubjectEnrollmentTerm @relation(fields: [studentSubjectEnrollmentId, academicTermId], references: [studentSubjectEnrollmentId, academicTermId], onDelete: Restrict)

  finalResult Decimal?            @db.Decimal(5, 2)
  status      ShsTermResultStatus @default(DRAFT)

  createdById String
  createdBy   User   @relation("ShsTermResultCreator", fields: [createdById], references: [id], onDelete: Restrict)

  finalizedById String?
  finalizedBy   User?     @relation("ShsTermResultFinalizer", fields: [finalizedById], references: [id], onDelete: Restrict)
  finalizedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentSubjectEnrollmentId, academicTermId])
  @@index([academicTermId])
  @@index([createdById])
  @@index([finalizedById])
}

model ShsTermResultInterpretationPolicy {
  id String @id @default(cuid())

  academicYearId String       @unique
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  passingThreshold Decimal                                 @db.Decimal(5, 2)
  sourceReference  String
  status           ShsTermResultInterpretationPolicyStatus @default(DRAFT)

  createdById String
  createdBy   User   @relation("ShsTermResultInterpretationPolicyCreator", fields: [createdById], references: [id], onDelete: Restrict)

  publishedById String?
  publishedBy   User?     @relation("ShsTermResultInterpretationPolicyPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  publishedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([publishedById])
}

model Grade {
  id String @id @default(cuid())

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  firstQuarter  Float?
  secondQuarter Float?
  thirdQuarter  Float?
  fourthQuarter Float?

  finalGrade Float?

  remarks String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([enrollmentId, subjectId])
}

model AuditLog {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  action String
  module String

  recordId   String?
  recordName String?

  description String

  metadata Json?

  createdAt DateTime @default(now())
}
