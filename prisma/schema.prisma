generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  REGISTRAR
  PRINCIPAL
  TEACHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  UNENROLLED
  ENROLLED
  GRADUATED
  TRANSFERRED
  DROPPED
}

enum Shift {
  MORNING
  AFTERNOON
}

enum Semester {
  FIRST
  SECOND
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  TRANSFERRED
}

enum StudentSubjectEnrollmentStatus {
  ACTIVE
  REPLACED
}

enum AcademicYearStatus {
  DRAFT
  ACTIVE
  LOCKED
  ARCHIVED
}

enum ShsSubjectClassification {
  CORE
  ACADEMIC_ELECTIVE
  TECHPRO_ELECTIVE
}

enum ShsCurriculumStatus {
  PROVISIONAL_DEPED
  SCHOOL_APPROVED
}

enum ShsCurriculumClusterTrack {
  ACADEMIC
  TECHPRO
}

enum ShsCurriculumReferenceTermApplicability {
  UNSPECIFIED
  ALL_CONFIGURED_TERMS
  ONE_CONFIGURED_TERM_UNRESOLVED
}

model User {
  id String @id @default(cuid())

  employeeNumber String? @unique

  username     String @unique
  email        String @unique
  passwordHash String

  firstName  String
  middleName String?
  lastName   String

  gender Gender

  role   UserRole
  status UserStatus @default(ACTIVE)

  isFirstLogin   Boolean   @default(true)
  lastLoginAt    DateTime?
  sessionVersion Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  teacher              Teacher?
  createdStudents      Student[]
  createdSections      Section[]
  createdSubjects      Subject[]
  createdEnrollments   Enrollment[]
  createdGrades        Grade[]
  createdAcademicYears AcademicYear[]
  createdAcademicTerms AcademicTerm[]
  createdSubjectOfferings SubjectOffering[]
  createdShsCurriculumClusters ShsCurriculumCluster[]
  createdSubjectOfferingShsContexts SubjectOfferingShsContext[]
  approvedSubjectOfferingShsContexts SubjectOfferingShsContext[] @relation("ShsCurriculumApprovalActor")
  createdShsCurriculumReferences ShsCurriculumReference[]
  createdStudentSubjectEnrollments StudentSubjectEnrollment[]
  auditLogs            AuditLog[]
}

model Student {
  id String @id @default(cuid())

  lrn String @unique

  firstName  String
  middleName String?
  lastName   String

  gender      Gender
  dateOfBirth DateTime?

  fatherName    String?
  fatherContact String?

  motherName    String?
  motherContact String?

  guardianName    String?
  guardianContact String?

  purok        String?
  barangay     String
  municipality String
  province     String
  zipCode      String?

  status StudentStatus @default(UNENROLLED)

  currentSectionId String?
  currentSection   Section? @relation("StudentCurrentSection", fields: [currentSectionId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  enrollments Enrollment[]

  @@index([currentSectionId])
}

model Teacher {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  degree    String?
  major     String?
  isAdviser Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  advisedSections    Section[]           @relation("SectionAdviser")
  subjectAssignments SubjectAssignment[]
}

model AcademicTerm {
  id String @id @default(cuid())

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  name      String
  position  Int
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subjectOfferings SubjectOfferingTerm[]
  studentSubjectEnrollmentTerms StudentSubjectEnrollmentTerm[]

  @@unique([academicYearId, position])
  @@index([academicYearId])
  @@index([createdById])
}

model Section {
  id String @id @default(cuid())

  gradeLevel  String
  trackStrand String?
  sectionName String

  adviserId String?
  adviser   Teacher? @relation("SectionAdviser", fields: [adviserId], references: [id])

  room  String?
  shift Shift?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  subjectAssignments SubjectAssignment[]
  enrollments        Enrollment[]
  currentStudents    Student[]           @relation("StudentCurrentSection")
}

model Subject {
  id String @id @default(cuid())

  code        String
  description String

  gradeLevel  String
  trackStrand String?

  semester Semester?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  assignments SubjectAssignment[]
  offerings   SubjectOffering[]
  grades      Grade[]
  shsCurriculumReferences ShsCurriculumReference[]
}

model SubjectAssignment {
  id String @id @default(cuid())

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])

  schedule       String?
  room           String?
  shift          Shift?
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([subjectId, teacherId, sectionId, academicYearId])
  @@index([academicYearId])
}

model Enrollment {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  semester Semester?

  status EnrollmentStatus @default(ACTIVE)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  grades Grade[]
  studentSubjectEnrollments StudentSubjectEnrollment[]

  @@unique([studentId, academicYearId])
  @@index([academicYearId])
}

model AcademicYear {
  id String @id @default(cuid())

  label     String             @unique
  startDate DateTime           @db.Date
  endDate   DateTime           @db.Date
  status    AcademicYearStatus @default(DRAFT)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments        Enrollment[]
  subjectAssignments SubjectAssignment[]
  terms              AcademicTerm[]
  subjectOfferings   SubjectOffering[]

  @@index([status])
  @@index([startDate])
  @@index([createdById])
}

model SubjectOffering {
  id String @id @default(cuid())
  subjectId String
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  gradeLevel String
  subjectCode String
  subjectDescription String
  createdById String
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  terms SubjectOfferingTerm[]
  shsContext SubjectOfferingShsContext?
  studentSubjectEnrollments StudentSubjectEnrollment[]
  @@index([academicYearId])
  @@index([subjectId])
}

model ShsCurriculumCluster {
  id String @id @default(cuid())

  code String
  name String
  track ShsCurriculumClusterTrack
  sourceReference String?

  createdById String
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  subjectOfferingContexts SubjectOfferingShsContext[]
  references ShsCurriculumReference[]

  @@index([track])
  @@index([createdById])
}

model ShsCurriculumReference {
  id String @id @default(cuid())

  subjectId String
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradeLevel String
  classification ShsSubjectClassification
  curriculumStatus ShsCurriculumStatus @default(PROVISIONAL_DEPED)

  clusterId String?
  cluster ShsCurriculumCluster? @relation(fields: [clusterId], references: [id], onDelete: Restrict)

  sourceReference String
  termApplicability ShsCurriculumReferenceTermApplicability

  createdById String
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId])
  @@index([gradeLevel, classification])
  @@index([clusterId])
  @@index([curriculumStatus])
  @@index([createdById])
}

model SubjectOfferingShsContext {
  subjectOfferingId String @id
  subjectOffering SubjectOffering @relation(fields: [subjectOfferingId], references: [id], onDelete: Restrict)

  classification ShsSubjectClassification
  curriculumStatus ShsCurriculumStatus

  clusterId String?
  cluster ShsCurriculumCluster? @relation(fields: [clusterId], references: [id], onDelete: Restrict)

  sourceReference String?
  approvalReference String?
  approvedById String?
  approvedBy User? @relation("ShsCurriculumApprovalActor", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt DateTime?

  createdById String
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clusterId])
  @@index([curriculumStatus])
  @@index([createdById])
  @@index([approvedById])
}

model SubjectOfferingTerm {
  subjectOfferingId String
  subjectOffering SubjectOffering @relation(fields: [subjectOfferingId], references: [id], onDelete: Restrict)
  academicTermId String
  academicTerm AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  @@id([subjectOfferingId, academicTermId])
  @@index([academicTermId])
}

model StudentSubjectEnrollment {
  id String @id @default(cuid())

  enrollmentId String
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  subjectOfferingId String
  subjectOffering SubjectOffering @relation(fields: [subjectOfferingId], references: [id], onDelete: Restrict)

  subjectCode String
  subjectDescription String
  gradeLevel String

  shsClassification ShsSubjectClassification?
  shsClusterCode String?
  shsClusterName String?
  shsCurriculumStatus ShsCurriculumStatus?
  shsSourceReference String?
  shsApprovalReference String?

  status StudentSubjectEnrollmentStatus @default(ACTIVE)
  replacedAt DateTime?

  createdById String
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms StudentSubjectEnrollmentTerm[]

  @@index([enrollmentId, status])
  @@index([subjectOfferingId])
  @@index([createdById])
}

model StudentSubjectEnrollmentTerm {
  studentSubjectEnrollmentId String
  studentSubjectEnrollment StudentSubjectEnrollment @relation(fields: [studentSubjectEnrollmentId], references: [id], onDelete: Restrict)

  academicTermId String
  academicTerm AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Restrict)

  @@id([studentSubjectEnrollmentId, academicTermId])
  @@index([academicTermId])
}

model Grade {
  id String @id @default(cuid())

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  firstQuarter  Float?
  secondQuarter Float?
  thirdQuarter  Float?
  fourthQuarter Float?

  finalGrade Float?

  remarks String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([enrollmentId, subjectId])
}

model AuditLog {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  action String
  module String

  recordId   String?
  recordName String?

  description String

  metadata Json?

  createdAt DateTime @default(now())
}
